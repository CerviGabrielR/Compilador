def incCinco(int v) {
    int r;
    r = v + 5;
    return r;
}

def produtoSimples(int a, int b) {
    int r;
    int i;
    r = 0;
    for(i = 0; i < b; i = i + 1) {
        r = r + a;
    }
    return r;
}


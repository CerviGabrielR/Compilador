def somaRange(int inicio) {
    int i;
    int total;
    total = 0;
    for(i = inicio; i < inicio + 10; i = i + 1) {
        total = total + i;
    }
    return total;
}

def escolheMaior(int a, int b) {
    int r;
    if(a > b) {
        r = a;
    } else {
        r = b;
    }
    return r;
}

